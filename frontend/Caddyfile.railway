# Railway: serves the built screens and forwards /api to the backend service's address
# (BACKEND_URL). deploy/docker-compose.yml mounts deploy/Caddyfile over this file.

:{$PORT:80} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy {$BACKEND_URL} {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		root * /srv
		# /uz, /ru and /en get the page with link previews in that language (V2_PLAN W2).
		try_files {path} {path}.html /index.html
		file_server
	}
}
